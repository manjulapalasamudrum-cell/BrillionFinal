# Python leaves these behind whenever check-bank.py is imported rather than run.
__pycache__/
*.pyc

# A clone of the separate github.com/manjulapalasamudrum-cell/Brillion.io repo
# sits in a subfolder of this one. Git saw its .git directory and recorded it as
# a submodule gitlink, which would publish a link to a commit nobody else can
# fetch. It is a different repository that happens to live here; ignore it.
/Brillion.io/

# Editor and OS noise.
.vscode/
.idea/
Thumbs.db
desktop.ini

# docs/index.html is deliberately NOT ignored: it is what GitHub Pages serves,
# so the built page has to be in the repo. dist/ holds only the Artifact body.
# Rerun environment\build.ps1 and commit the result after changing anything
# under src/.
